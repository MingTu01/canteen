<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.canteen.mapper.DepartmentMapper">
    <select id="selectByStoreId" resultType="com.example.canteen.entity.Department">
        SELECT * FROM department WHERE store_id = #{storeId} AND status = 1 ORDER BY id
    </select>
</mapper>
