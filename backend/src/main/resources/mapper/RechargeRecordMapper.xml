<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.canteen.mapper.RechargeRecordMapper">
    <select id="selectByStoreId" resultType="com.example.canteen.entity.RechargeRecord">
        SELECT * FROM recharge_record WHERE store_id = #{storeId} ORDER BY created_at DESC
    </select>

    <select id="selectByEmployeeId" resultType="com.example.canteen.entity.RechargeRecord">
        SELECT * FROM recharge_record WHERE employee_id = #{employeeId} ORDER BY created_at DESC
    </select>
</mapper>
