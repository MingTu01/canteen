# =============================================================================
# 企业智慧食堂系统 - 环境变量配置示例
# =============================================================================
# 用法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 修改下面的值为你的实际配置
#   3. 启动服务:  docker compose up -d
#
# 注意:
#   - .env 文件包含敏感信息,不要提交到 Git(已在 .gitignore 中忽略)
#   - 所有带 change-me 的值必须修改!
#   - 首次部署推荐使用 ./deploy.sh 交互式向导,会自动生成随机密钥
# =============================================================================

# ---------- MySQL 数据库 ----------
# MySQL root 密码(生产环境必须修改!deploy.sh 会自动生成随机值)
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# 数据库名(默认 canteen,通常不需要修改)
MYSQL_DATABASE=canteen

# ---------- P1-3: MySQL 应用专用用户(可选,推荐生产环境配置) ----------
# 配置后后端运行时用此用户(最小权限:仅 DML),Flyway 迁移用 root
# 不配置则后端默认用 root(向后兼容)
# 首次部署需配合 scripts/init-db-user.sh 创建此用户(注意是 .sh 不是 .sql)
# DB_APP_USERNAME=canteen_app
# DB_APP_PASSWORD=change-me-to-a-strong-app-password

# ---------- Redis 缓存 ----------
# Redis 密码(生产环境必须修改!deploy.sh 会自动生成随机值)
REDIS_PASSWORD=change-me-to-a-strong-redis-password

# ---------- JWT 认证 ----------
# JWT 签名密钥(生产环境必须修改!deploy.sh 会自动生成 64 位随机十六进制)
# 长度建议 ≥ 32 字符,用 openssl rand -hex 32 生成
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 各角色 Token 过期时间(毫秒)
# 管理后台 Token:默认 24 小时(86400000)
JWT_EXPIRATION=86400000
# H5 员工 Token:默认 30 天(2592000000)
JWT_EMPLOYEE_EXPIRATION=2592000000
# X86 终端 Token:默认 365 天(31536000000)
JWT_TERMINAL_EXPIRATION=31536000000

# ---------- P0-5: CORS 允许的 Origin(可选,生产环境推荐配置) ----------
# 逗号分隔的精确 origin 白名单,配置后仅放行白名单内的 origin
# 留空则放行所有 origin(兼容内网多 origin 部署)
# 示例:CORS_ALLOWED_ORIGINS=https://dm.canteen.example.com,https://admin.canteen.example.com
CORS_ALLOWED_ORIGINS=

# ---------- P1-1: 备份加密(可选,生产环境强烈推荐配置) ----------
# 配置后 backup.sh 与后端 BackupIO 会用 AES-256 加密备份文件
# 丢失此密钥将无法恢复备份!请妥善保存到密码管理器
# 用 openssl rand -hex 32 生成
# BACKUP_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# ---------- P1-5: 容器非 root 降权(自动配置,通常不需要手动修改) ----------
# deploy.sh 会自动检测宿主机运行用户的 UID/GID 并写入这里
# docker-compose.yml 用 user: "${PUID}:${PGID}" 让容器以该 UID 运行(非 root)
# 默认 1000(Ubuntu/Debian 第一个普通用户)
PUID=1000
PGID=1000

# ---------- 初始超管账号(可选,仅首次部署生效) ----------
# 部署后可通过这些环境变量在首次启动时自定义超管账号密码
# 不设置则使用默认账号 admin / 123456(强烈建议设置自定义值)
# 注意:仅在 admin 表为空或仅有默认 admin 账号时生效,不会覆盖已创建的其他管理员
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD=your-strong-password-at-least-8-chars

# ---------- 备份脚本相关(scripts/backup.sh / restore.sh 读取) ----------
# 这些变量供宿主机上的备份/恢复脚本连接 MySQL 使用。
# 注意:Docker 部署模式下脚本会优先通过 docker exec 直连容器(mysql 3306),
#       不使用宿主机端口;仅当 MySQL 不在 Docker 中运行时才用下面的宿主机地址。
# 若需宿主机直连,注意 docker-compose 将 MySQL 映射到宿主机 127.0.0.1:13306。
# SPRING_DATASOURCE_HOST=127.0.0.1
# SPRING_DATASOURCE_PORT=13306
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=change-me-to-a-strong-password

# ---------- 微信公众号登录(可选) ----------
# 配置后 H5 在微信浏览器内可使用"微信登录"按钮,员工首次需输入手机号+密码绑定
# 获取方式:微信开发者平台(developers.weixin.qq.com)→ 控制台 → 公众号详情 → AppID/AppSecret
# 同时需在 mp.weixin.qq.com → 功能设置 → 网页授权域名 填写 H5 域名(需443端口,不支持带端口)
# 还需在开发者平台 → API IP白名单 添加服务器公网IP
# 不配置则 H5 微信登录按钮不显示功能不可用(不影响手机号登录)
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret

# ---------- 微信公众号订阅消息推送(可选) ----------
# 注意:旧版模板消息已于2021-04-30下线,2026-08起多模板体系也已下线
# 现使用一次性订阅消息接口 message/template/subscribe(接口英文名 templateSubscribe)
# 2026-08起每个公众号仅剩一个固定的一次性订阅消息模板(无需申请,无多模板)
# 获取方式:微信开发者平台(developers.weixin.qq.com)→ 控制台 → 服务号
#   → 一次性订阅消息 → 复制模板ID(两项配置填同一模板ID)
# 员工需在H5「我的 → 微信提醒订阅」中授权,每次授权可接收一条消息
# 配置后系统在以下场景向已订阅的员工推送订阅消息:
#   1. 通知/公告/活动发布时 → 推送给门店所有已订阅员工(scene=1000)
#   2. 员工下单成功时 → 推送给该员工(含订单日期、餐次,scene=1001)
# 不配置则不推送订阅消息(不影响微信登录)
# WECHAT_TEMPLATE_NOTIFY=通知订阅消息模板ID
# WECHAT_TEMPLATE_ORDER=订单订阅消息模板ID
# H5 访问基础URL(用于订阅消息点击跳转,如 https://canteen.example.com,末尾不带斜杠)
# 需以标准443端口提供HTTPS(微信域名配置不支持带端口)
# WECHAT_H5_BASE_URL=https://canteen.example.com

# ---------- 微信公众号消息/事件回调(可选,关注后自动回复) ----------
# 配置后需在微信开发者平台「域名与消息推送配置」填:
#   URL: https://你的H5域名/api/wechat/callback (需443端口,不支持带端口)
#   Token: 与下方 WECHAT_TOKEN 一致(自定义或脚本生成)
#   EncodingAESKey: 明文模式随机填即可(不参与校验)
#   消息加解密方式: 选「明文模式」
# 配置后关注公众号会自动回复图文卡片引导员工进入H5订餐
# 不配置则回调接口拒绝请求(不影响微信登录与订阅消息)
# WECHAT_TOKEN=your-wechat-callback-token
# 图文卡片封面图URL(建议900x500,公网可访问;不配置则回退纯文本回复)
# WECHAT_H5_BANNER_URL=https://canteen.example.com/banner.png
# 食堂名称(关注回复文案用,不配置显示"企业食堂")
# WECHAT_CANTEEN_NAME=XX企业食堂
